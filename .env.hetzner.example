# ============================================================
# Compass — Hetzner deployment env template
# Copy to `.env` on VM, wypełnij wartościami, NIGDY nie commituj.
# ============================================================

# --- Port na Host VM (reverse proxy maps 80/443 → APP_PORT) ---
APP_PORT=10000

# --- Supabase (managed) ---
# Źródło: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...          # anon (public) key — rotowany po leaku
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...              # service role — NIGDY do klienta

# --- Domena aplikacji (publiczna) ---
# Używane do email linków, redirectów Supabase auth, metadata
NEXT_PUBLIC_APP_URL=https://compass.example.com
NEXT_PUBLIC_SITE_URL=https://compass.example.com

# --- OpenAI (AI matching, embeddings, CV parsing) ---
OPENAI_API_KEY=sk-proj-...

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...

# --- CRON protection (chroni /api/cron/* endpointy) ---
# Wygeneruj np. `openssl rand -hex 32`
CRON_SECRET=change-me

# --- Super admin emails (comma-separated, lowercase) ---
# Nie commitować — ustawiamy tylko w runtime/CI secret
SUPER_ADMIN_EMAILS=example.admin1@example.com,example.admin2@example.com

# --- Runtime flags ---
NODE_ENV=production
# Consultant Success Hub: włączaj etapami. Automatyzacje zaczynają w shadow mode.
CONSULTANT_SUCCESS_ENABLED=true
CONSULTANT_SUCCESS_AUTOMATIONS_ENABLED=true
CONSULTANT_SUCCESS_SURVEYS_ENABLED=false
CONSULTANT_SUCCESS_SHADOW_MODE=true
# Osobny sekret HMAC (min. 32 bajty), np. `openssl rand -base64 48`.
# Pozostawienie pustego pola bezpiecznie blokuje wysyłkę ankiet.
CONSULTANT_SUCCESS_TOKEN_SECRET=
# ALLOW_BYPASS_LOGIN=false  # NIGDY nie ustawiać w prod (i tak guard w kodzie blokuje)

# --- Emergency dev bypass (TYLKO w DEV, NIE ustawiać w prod) ---
# BYPASS_EMAIL=admin@example.com
# BYPASS_FULL_NAME=Admin
# BYPASS_USER_ID=uuid-here
