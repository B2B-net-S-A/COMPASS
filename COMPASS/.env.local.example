# Supabase (optional — if missing, app runs in no-backend mode: no auth, empty data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Prefer a dedicated sb_secret key; legacy service_role remains a
# temporary fallback. Never prefix either credential with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key

# OpenAI (AI matching & assistant features)
OPENAI_API_KEY=sk-your-openai-key

# Resend (transactional emails)
RESEND_API_KEY=re_your-resend-key
