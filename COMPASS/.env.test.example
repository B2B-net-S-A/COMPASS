# --- Adres testowanej instancji (WYMAGANY, brak fallbacku) ---
# UWAGA: nie ma środowiska staging. Ten sam adres co produkcja oznacza testy
# przeciw żywym danym 46 pracowników, a zestaw e2e zawiera testy PISZĄCE
# (e2e/04-rls-database.spec.ts robi POST /auth/v1/signup).
# Domyślnie celuj w lokalną instancję:
BASE_URL=http://localhost:10000
PLAYWRIGHT_BASE_URL=http://localhost:10000

# --- Supabase staging (same project as Hetzner staging app) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# CRITICAL: service role key — needed to create/promote test users + cleanup
# Source: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Konta testowe (zakładane RĘCZNIE) ---
# Audyt 2026-08: ten plik odsyłał do scripts/setup-test-users.ts, którego nie ma
# w repo. Konta zakłada się przez Administrację HR (zaproszenie) albo Supabase
# Dashboard → Auth, a ich adresy wpisuje poniżej. Hasło musi spełniać politykę
# aplikacji (min. 10 znaków, wielka litera, cyfra — lib/auth/password-policy.ts).
TEST_PASSWORD=ComPass-2026-Test1

TEST_CONSULTANT_EMAIL=e2e+consultant@b2bnetwork.pl
TEST_ADMIN_EMAIL=e2e+admin@b2bnetwork.pl

